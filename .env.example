# ---- Server ----
PORT=3000
NODE_ENV=development
# true when served over HTTPS
COOKIE_SECURE=false
# 1 when behind a reverse proxy
TRUST_PROXY=0
# REQUIRED: long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ---- Dashboard login (no database) - both REQUIRED ----
LOGIN_USERNAME=
LOGIN_PASSWORD=

# ---- EasyEcom credentials (server-side only) ----
EE_BASE_URL=https://api.easyecom.io
# Initial Bearer token (can be replaced later from the dashboard)
EE_JWT=
# REQUIRED: sent as the x-api-key header
EE_API_KEY=
API_TIMEOUT_MS=20000

# ---- Business configuration ----
SKU_LIST=S1-BL-S,S2-WH-S,S1-RD-M
MARKETPLACE_IDS=114,946,894,659,537
CARRIER_ID=35249
# true = Shipped Order also runs confirm_order first (status 2 orders)
CONFIRM_BEFORE_SHIP=false
MAX_ORDERS_PER_REQUEST=20
RETURN_LIMIT_PER_MARKETPLACE=2

# Persist a replaced JWT to .runtime/jwt.json (mode 600) so it survives restarts
PERSIST_TOKEN=true
